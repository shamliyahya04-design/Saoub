    "evaluation":"exact"
  },
  {
    "id":"B04",
    "class":"tool_invocation",
    "objective":"Select and invoke the required tool with valid arguments.",
    "success_criteria":["correct tool selected","arguments valid","tool result incorporated"],
    "evaluation":"trace_and_result"
  },
  {
    "id":"B05",
    "class":"failure_recovery",
